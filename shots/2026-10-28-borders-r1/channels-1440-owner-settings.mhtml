ontent-narrow: 680px; --content-media: 900px; --content-wide: 1120px; min-w=
idth: 320px; min-height: 100svh; position: relative; isolation: isolate; ba=
ckground: var(--bg); color: var(--text); font-family: var(--font-sans, "IBM=
 Plex Sans Variable", "IBM Plex Sans", system-ui, sans-serif); -webkit-font=
-smoothing: antialiased; overflow-x: hidden; }

.pn-landing::before { content: ""; position: absolute; z-index: -1; inset: =
0px 0px auto; height: min(760px, 76svh); background: radial-gradient(42% 54=
% at 50% 8%, rgba(252, 248, 240, 0.086), transparent 72%), linear-gradient(=
rgba(255, 255, 255, 0.01), transparent 64%); pointer-events: none; }

.pn-landing::after { content: ""; position: absolute; z-index: -1; inset: 0=
px; background: linear-gradient(90deg, transparent, rgba(252, 248, 240, 0.0=
1) 50%, transparent); pointer-events: none; }

.pn-landing, .pn-landing *, .pn-landing ::before, .pn-landing ::after { box=
-sizing: border-box; }

.pn-landing button { font: inherit; }

.pn-landing .page { position: relative; width: min(1240px, 100% - 64px); mi=
n-height: 100svh; margin: 0px auto; padding: 28px 0px 36px; display: flex; =
flex-direction: column; align-items: center; }

.pn-landing .brand { display: inline-flex; align-items: center; gap: 9px; c=
olor: var(--text); font-size: 18px; font-weight: 650; letter-spacing: -0.02=
