{
  "name": "skool",
  "label": "Skool style",
  "description": "A classroom community laid out the way Skool members expect: tabs across the top, a post feed as home, a course grid with progress, a calendar, members, a leaderboard and an About page. Light and neutral; pick your own accent colour.",
  "contract": 1,
  "layout_notes": {
    "navigation": {
      "position": "top",
      "tabs": [
        { "tab": "community", "label": "Community", "home": true },
        { "tab": "classroom", "label": "Classroom", "source": "resources" },
        { "tab": "calendar", "label": "Calendar", "source": "events" },
        { "tab": "members", "label": "Members" },
        { "tab": "leaderboard", "label": "Leaderboard", "needs": "points and levels" },
        { "tab": "agent", "label": "Ask AI", "source": "agent" },
        { "tab": "about", "label": "About", "source": "funnel" }
      ],
      "owner_tabs_after": ["workflows", "analytics", "settings"]
    },
    "pages": {
      "community": {
        "main": [{ "block": "posts_feed", "categories": "channels", "pinned_first": true, "sort": "latest_activity" }],
        "aside": [
          { "block": "community_card" },
          { "block": "leaderboard", "period": "30d", "limit": 5, "needs": "points and levels" },
          { "block": "upcoming_events", "limit": 3 }
        ]
      },
      "classroom": { "main": [{ "block": "resources", "view": "courses" }] },
      "calendar": { "main": [{ "block": "calendar", "view": "month" }] },
      "members": { "main": [{ "block": "members", "filters": ["all", "admins", "online"] }] },
      "leaderboard": { "main": [{ "block": "leaderboard", "periods": ["7d", "30d", "all"] }] },
      "about": { "main": [{ "block": "funnel" }] }
    }
  },
  "wanted_tokens": {
    "tab_indicator": "underline",
    "card_hover": "soft"
  }
}
