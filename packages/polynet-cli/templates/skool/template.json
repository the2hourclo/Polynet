{
  "name": "skool",
  "label": "Skool style",
  "description": "A classroom community laid out the way Skool members expect: tabs across the top, a post feed as home, a course grid with progress, a calendar, members and an About page. Built only from systems Polynet already has. Light and neutral; keeps your own colours if you have them.",
  "contract": 1,
  "apply": {
    "layout": "replace",
    "theme": "keep_existing"
  },
  "layout_notes": {
    "navigation": {
      "position": "top",
      "tabs": [
        {
          "tab": "community",
          "label": "Community",
          "home": true
        },
        {
          "tab": "classroom",
          "label": "Classroom",
          "source": "resources"
        },
        {
          "tab": "calendar",
          "label": "Calendar",
          "source": "events"
        },
        {
          "tab": "members",
          "label": "Members"
        },
        {
          "tab": "agent",
          "label": "Ask AI",
          "source": "agent"
        },
        {
          "tab": "about",
          "label": "About",
          "source": "funnel"
        }
      ],
      "owner_tabs_after": [
        "workflows",
        "analytics",
        "settings"
      ]
    },
    "pages": {
      "community": {
        "main": [
          {
            "block": "posts_feed",
            "categories": "channels",
            "pinned_first": true,
            "sort": "latest_activity"
          }
        ],
        "aside": [
          {
            "block": "community_card"
          },
          {
            "block": "upcoming_events",
            "limit": 3
          }
        ]
      },
      "classroom": {
        "main": [
          {
            "block": "resources",
            "view": "courses"
          }
        ]
      },
      "calendar": {
        "main": [
          {
            "block": "calendar",
            "view": "month"
          }
        ]
      },
      "members": {
        "main": [
          {
            "block": "members",
            "filters": [
              "all",
              "admins",
              "online"
            ]
          }
        ]
      },
      "about": {
        "main": [
          {
            "block": "funnel"
          }
        ]
      }
    }
  },
  "wanted_tokens": {
    "tab_indicator": "underline",
    "card_hover": "soft"
  }
}
